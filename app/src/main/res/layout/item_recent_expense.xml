<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <ImageView
        android:id="@+id/recentIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/blIconCircleBackground"
        android:contentDescription="@null"
        android:padding="9dp"
        app:tint="?attr/blAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/recentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/blTextPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recentMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="?attr/blTextSecondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/recentAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFeatureSettings="tnum"
        android:textColor="?attr/blTextPrimary"
        android:textSize="14sp" />
</LinearLayout>
