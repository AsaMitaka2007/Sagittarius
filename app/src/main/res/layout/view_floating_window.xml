<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/floatingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="5dp">

    <com.dsha.sagittarius.ui.LiquidGlassView
        android:id="@+id/glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <com.dsha.sagittarius.ui.WeatherCapsuleEffectView
            android:id="@+id/weatherEffect"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/stateDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="?attr/blIconCircleBackground" />

                <TextView
                    android:id="@+id/tvRangeFloating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?attr/blTextSecondary"
                    android:textSize="11sp"
                    tools:text="本月 · 2025年6月" />

                <TextView
                    android:id="@+id/btnCloseFloating"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/blFloatingButtonBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="关闭"
                    android:textColor="?attr/blWarningText"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnCollapse"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="?attr/blFloatingButtonBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="收起"
                    android:textColor="?attr/blTextPrimary"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dragHandle"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:contentDescription="拖动悬浮窗"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="⠿"
                    android:textColor="?attr/blTextSecondary"
                    android:textSize="19sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/collapsedBody"
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCollapsedValue"
                    android:layout_width="match_parent"
                    android:layout_height="19dp"
                    android:autoSizeMaxTextSize="11sp"
                    android:autoSizeMinTextSize="7sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFeatureSettings="tnum"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="¥0.00"
                    android:textColor="?attr/blTextPrimary" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/expandedBody"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRemainingFloating"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="30sp"
                        tools:text="¥2,860.50" />

                    <TextView
                        android:id="@+id/tvPercentFloating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="?attr/blTextSecondary"
                        android:textSize="11sp"
                        tools:text="剩余 71%" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBudgetFloating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/blTextSecondary"
                    android:textSize="10sp"
                    tools:text="预算 ¥4,000.00 · 已用 ¥1,139.50" />

                <com.dsha.sagittarius.ui.GlassProgressView
                    android:id="@+id/progressFloating"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="9dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip7"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="?attr/blFloatingChipBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="近7天"
                            android:textColor="?attr/blTextPrimary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/chipWeek"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="5dp"
                            android:background="?attr/blFloatingChipBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="本周"
                            android:textColor="?attr/blTextPrimary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/chipMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="5dp"
                            android:background="?attr/blFloatingChipBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="本月"
                            android:textColor="?attr/blTextPrimary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/chipLastMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="5dp"
                            android:background="?attr/blFloatingChipBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="上月"
                            android:textColor="?attr/blTextPrimary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/chipCustom"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="5dp"
                            android:background="?attr/blFloatingChipBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:text="自定义"
                            android:textColor="?attr/blTextPrimary"
                            android:textSize="10sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/customRangePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="?attr/blFloatingButtonBackground"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etCustomStart"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="?attr/blInputBackground"
                            android:fontFeatureSettings="tnum"
                            android:hint="2025-06-01"
                            android:digits="0123456789-"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLength="10"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="?attr/blTextPrimary"
                            android:textColorHint="?attr/blTextTertiary"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:text="至"
                            android:textColor="?attr/blTextSecondary"
                            android:textSize="10sp" />

                        <EditText
                            android:id="@+id/etCustomEnd"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="?attr/blInputBackground"
                            android:fontFeatureSettings="tnum"
                            android:hint="2025-06-30"
                            android:digits="0123456789-"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:maxLength="10"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="?attr/blTextPrimary"
                            android:textColorHint="?attr/blTextTertiary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnApplyCustom"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp"
                        android:background="?attr/blFloatingAccentBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="应用日期范围"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnBudgetEdit"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="?attr/blFloatingButtonBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="设置预算"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnAllHistory"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:background="?attr/blFloatingButtonBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="查看全部记录"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/budgetEditorPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etBudget"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="?attr/blInputBackground"
                        android:fontFeatureSettings="tnum"
                        android:hint="预算金额"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="12"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="?attr/blTextPrimary"
                        android:textColorHint="?attr/blTextTertiary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnSaveBudget"
                        android:layout_width="64dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/blFloatingAccentBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="保存"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="快速记一笔"
                    android:textColor="?attr/blTextPrimary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etQuickAmount"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:background="?attr/blInputBackground"
                        android:fontFeatureSettings="tnum"
                        android:hint="金额"
                        android:imeOptions="actionNext"
                        android:inputType="numberDecimal"
                        android:maxLength="12"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="?attr/blTextPrimary"
                        android:textColorHint="?attr/blTextTertiary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnQuickCategory"
                        android:layout_width="62dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/blFloatingButtonBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="餐饮"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btnQuickAdd"
                        android:layout_width="56dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/blFloatingAccentBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="添加"
                        android:textColor="?attr/blTextPrimary"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etQuickNote"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:background="?attr/blInputBackground"
                    android:hint="备注（可选）"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="60"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="?attr/blTextPrimary"
                    android:textColorHint="?attr/blTextTertiary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="当前范围最近记录"
                    android:textColor="?attr/blTextPrimary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/recentContainerFloating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvNoRecentFloating"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:text="暂无记录，记下第一笔吧"
                    android:textColor="?attr/blTextTertiary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnFloatingHistory"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/blFloatingButtonBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="查看全部记录  →"
                    android:textColor="?attr/blAccent"
                    android:textSize="11sp" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </com.dsha.sagittarius.ui.LiquidGlassView>
</FrameLayout>
