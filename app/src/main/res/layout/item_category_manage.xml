<?xml version="1.0" encoding="utf-8"?>
<com.dsha.sagittarius.ui.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/categoryRow"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginBottom="9dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/categoryIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/blIconCircleBackground"
            android:contentDescription="@null"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/blTextPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvCategoryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/blTextSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/blIconButtonBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/category_delete_action"
            android:textColor="?attr/blWarningText"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</com.dsha.sagittarius.ui.GlassCardView>
