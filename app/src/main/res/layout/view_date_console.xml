<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/tvConsoleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/dateRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvConsoleDatePrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.42"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:gravity="end"
            android:maxLines="1"
            android:paddingEnd="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvConsoleDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvConsoleDateNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:alpha="0.42"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:fontFeatureSettings="tnum"
            android:gravity="start"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnConsoleLock"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_date_console_button"
            android:clickable="true"
            android:contentDescription="@string/date_console_lock"
            android:focusable="true"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnConsoleRange"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_date_console_button"
            android:clickable="true"
            android:contentDescription="@string/date_console_custom"
            android:focusable="true"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnConsoleColor"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_date_console_button"
            android:clickable="true"
            android:contentDescription="@string/date_console_color"
            android:focusable="true"
            android:gravity="center" />
    </LinearLayout>
</merge>
