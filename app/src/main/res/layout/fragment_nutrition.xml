<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp">

        <com.dsha.sagittarius.ui.DateConsoleView
            android:id="@+id/dateConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/nutrition_subtitle"
            android:textColor="?attr/blTextSecondary"
            android:textSize="13sp" />

        <com.dsha.sagittarius.ui.NutritionRingsView
            android:id="@+id/nutritionRings"
            android:layout_width="match_parent"
            android:layout_height="270dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvNutritionDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/blTextPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNutritionTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="?attr/blTextSecondary"
            android:textSize="11sp" />

        <com.dsha.sagittarius.ui.NutritionLegendView
            android:id="@+id/nutritionLegend"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/btnEditGoals"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/nutrition_goal_edit" />

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/btnSpecialGoals"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/nutrition_special_goal" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvDietEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:text="@string/nutrition_empty"
                android:textColor="?attr/blTextTertiary"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
