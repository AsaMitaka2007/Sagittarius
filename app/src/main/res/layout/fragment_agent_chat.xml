<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/emptyPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_agent_empty"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <com.dsha.sagittarius.agent.ui.AgentLogoView
                    android:layout_width="188dp"
                    android:layout_height="188dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/agent_empty_title"
                    android:textColor="?attr/blTextPrimary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/chipExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:padding="14dp"
                    android:text="@string/agent_example_expense"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/chipDiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:padding="14dp"
                    android:text="@string/agent_example_diet"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/chipTaxi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:padding="14dp"
                    android:text="@string/agent_example_taxi"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnScrollBottom"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_agent_ink_border"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center"
                android:text="↓"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="52dp"
                android:background="@drawable/bg_agent_ink_border"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/agent_retry"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_agent_ink"
                android:gravity="top|start"
                android:hint="@string/agent_input_hint"
                android:imeOptions="actionNone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="46dp"
                android:paddingStart="15dp"
                android:paddingTop="11dp"
                android:paddingEnd="15dp"
                android:paddingBottom="11dp"
                android:textColor="#F2F5FA"
                android:textColorHint="#8C95A6"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnSessions"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:contentDescription="@string/agent_sessions"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_sessions_silhouette" />

                <ImageView
                    android:id="@+id/btnWebSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:contentDescription="@string/agent_web_search"
                    android:padding="13dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_agent_web" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnReasoning"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:drawableStart="@drawable/ic_agent_reasoning"
                    android:drawablePadding="6dp"
                    android:drawableTint="#FFFFFF"
                    android:gravity="center"
                    android:minWidth="74dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:text="@string/agent_reasoning_short"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnSend"
                    android:layout_width="52dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_agent_ink_border"
                    android:contentDescription="@string/agent_send"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/capsuleHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone" />
</FrameLayout>
