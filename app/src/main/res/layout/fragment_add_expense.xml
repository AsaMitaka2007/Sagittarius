<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">
        <com.dsha.sagittarius.ui.DateConsoleView
            android:id="@+id/dateConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
<TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/add_page_subtitle"
            android:textColor="?attr/blTextSecondary"
            android:textSize="13sp" />

        <com.dsha.sagittarius.ui.ModeSwitchView
            android:id="@+id/modeSwitch"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp" />

        <FrameLayout
            android:id="@+id/bubbleWheelContainer"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="2dp">

            <com.dsha.sagittarius.ui.CategoryWheelView
                android:id="@+id/categoryWheel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.dsha.sagittarius.ui.BubbleAmountView
                android:id="@+id/bubbleAmount"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <com.dsha.sagittarius.ui.GlassChipView
            android:id="@+id/btnAddCategory"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:text="@string/add_category_action" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/category_wheel_hint"
            android:textColor="?attr/blTextTertiary"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/note_label"
            android:textColor="?attr/blTextPrimary"
            android:textSize="15sp" />

        <com.dsha.sagittarius.ui.GlassCardView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_note"
                    app:tint="?attr/blGradientEnd" />

                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/note_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="60"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="?attr/blTextPrimary"
                    android:textColorHint="?attr/blTextTertiary"
                    android:textSize="15sp" />
            </LinearLayout>
        </com.dsha.sagittarius.ui.GlassCardView>

        <com.dsha.sagittarius.ui.GradientActionButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:enabled="false"
            android:text="@string/save_expense" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
