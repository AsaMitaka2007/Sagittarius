<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="34dp">

        <com.dsha.sagittarius.ui.DateConsoleView
            android:id="@+id/dateConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/diet_page_subtitle"
            android:textColor="?attr/blTextSecondary"
            android:textSize="13sp" />

        <com.dsha.sagittarius.ui.ModeSwitchView
            android:id="@+id/modeSwitch"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/chipBreakfast"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="@string/meal_breakfast" />

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/chipLunch"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/meal_lunch" />

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/chipDinner"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/meal_dinner" />

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/chipSnack"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/meal_snack" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="2dp">

            <com.dsha.sagittarius.ui.FoodTrackView
                android:id="@+id/foodTrack"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.dsha.sagittarius.ui.DietBubbleView
                android:id="@+id/dietBubble"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tvFoodEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="@string/diet_empty_favorites"
                android:textColor="?attr/blTextTertiary"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/btnCustomFood"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/diet_add_custom_food" />

            <com.dsha.sagittarius.ui.GlassChipView
                android:id="@+id/btnClearDiet"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:text="@string/diet_clear" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/diet_choose_food_hint"
            android:textColor="?attr/blTextTertiary"
            android:textSize="11sp" />

        <com.dsha.sagittarius.ui.GradientActionButton
            android:id="@+id/btnSaveDiet"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/diet_save" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
