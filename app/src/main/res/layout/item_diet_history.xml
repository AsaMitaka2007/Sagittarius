<?xml version="1.0" encoding="utf-8"?>
<com.dsha.sagittarius.ui.SwipeRevealLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/historyContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/blCardFillTop"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvFoodIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/blIconCircleBackground"
            android:gravity="center"
            android:text="🍽️"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/blTextPrimary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvFoodAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/blTextTertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFoodCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="?attr/blTextSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:background="#D9534F"
        android:gravity="center"
        android:text="删除"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />
</com.dsha.sagittarius.ui.SwipeRevealLayout>
