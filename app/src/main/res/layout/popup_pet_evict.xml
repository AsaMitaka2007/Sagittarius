<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_agent_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/btnEvict"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/agent_pet_evict"
        android:gravity="center"
        android:text="❌"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/btnLock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/agent_pet_lock"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lock_silhouette"
        app:tint="?attr/blAccent" />
</LinearLayout>
