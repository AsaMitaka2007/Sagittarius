<?xml version="1.0" encoding="utf-8"?>
<!-- 联网开启：米白半透明底 + 米白描边 + 右上角状态点 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33F3EBDD" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.4dp"
                android:color="#FFF3EBDD" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <size
                android:width="8dp"
                android:height="8dp" />
            <solid android:color="#FFF3EBDD" />
        </shape>
    </item>
</layer-list>
